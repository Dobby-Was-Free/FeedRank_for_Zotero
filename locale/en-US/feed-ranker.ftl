# Only the item-pane section needs Fluent: Zotero's schema for `header`/`sidenav` requires an
# l10nID (there is no plain-label child), so its text has to come from here. Every other
# user-facing string -- menus, notices, reports, the settings panes -- lives in
# chrome/content/strings.js, which is why the menu entries are not repeated here.

feed-ranker-score-details-section =
    .label = FeedRank Score

feed-ranker-score-details-sidenav =
    .tooltiptext = FeedRank Score Details
